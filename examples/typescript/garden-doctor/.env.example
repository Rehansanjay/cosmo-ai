# No API key here: `npm run dev` mints short-lived tokens via the app's
# own /token route, off COSMO_API_KEY in your shell, else the credential
# `cosmo init` stored.

# Which Cosmo backend to connect to.
VITE_COSMO_BASE_URL=https://platform.askcosmo.ai

# Where a keyless (hosted-mode) build mints tokens. Defaults to /token on the
# same origin; a build bundled away from its Function (e.g. a native shell)
# sets the deployed endpoint absolutely.
# VITE_TOKEN_ENDPOINT=https://your-project.pages.dev/token

