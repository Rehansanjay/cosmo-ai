# Copy to .env (gitignored — never commit real keys):
#   cp .env.example .env
#
# Both are optional: the app also lets you paste them into the form at
# runtime. Setting them just saves retyping on every run.

# No API key here: `npm run dev` mints short-lived tokens via the app's
# own /token route, off COSMO_API_KEY in your shell, else the credential
# `cosmo init` stored.

# Which Cosmo backend to connect to.
VITE_COSMO_BASE_URL=https://platform.askcosmo.ai

# Port for the URL-fetch backend. The Vite dev server proxies /local to 7871.
# DOCS_AGENT_PORT=7871

