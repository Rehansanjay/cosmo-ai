# No API key here: `npm run dev` mints short-lived tokens via the app's
# own /token route, off COSMO_API_KEY in your shell, else the credential
# `cosmo init` stored.

# Which Cosmo backend to connect to.
VITE_COSMO_BASE_URL=https://platform.askcosmo.ai

# Which realtime provider runs the cook: openai (default) or gemini. The agent
# is identical either way. GPT Realtime needs the OpenAI provider enabled on
# the workspace — see the README.
# VITE_REALTIME_PROVIDER=gemini

